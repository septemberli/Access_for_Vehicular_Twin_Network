
theory Proposed_Vehicle_Access
begin

builtins: diffie-hellman, symmetric-encryption

functions:
  h1/1,
  h2/1,
  mask/2,
  unmask/2,
  cheb_eval/2

equations:
  unmask(mask(m,k),k) = m


/* ------------------------------------------------------------------------- */
/* Initialization, registration, and the compositional RSU--TA assumption.  */
/* ------------------------------------------------------------------------- */

rule Init_TA:
  [ Fr(~skT) ]
  --[ InitTA(~skT) ]->
  [ !TAKey(~skT)
  , !TAPub('g'^~skT)
  , Out('g'^~skT)
  ]

restriction One_TA:
  "All x y #i #j. InitTA(x)@i & InitTA(y)@j ==> #i = #j"

rule Register_Vehicle:
  let sV = h1(<'VEHICLE-LONG-TERM',skT,~V,~rhoV>)
  in
  [ !TAKey(skT), Fr(~V), Fr(~rhoV) ]
  --[ RegisterVehicle(~V,sV) ]->
  [ !VLong(~V,sV)
  , !TAVehicle(~V,sV)
  ]

/*
 * This rule is the only assumption imported from the preceding RSU--TA
 * enrollment phase.  R and tidR are public; skTJ is shared only by R and TA.
 */
rule Assume_Secure_RSU_TA_Channel:
  [ Fr(~R), Fr(~tidR), Fr(~skTJ) ]
  --[ AssumedSecureChannel(~R,~tidR,~skTJ) ]->
  [ !PublicRSU(~R)
  , !RChannel(~R,~tidR,~skTJ)
  , !TAChannel(~R,~tidR,~skTJ)
  , Out(~R)
  , Out(~tidR)
  ]

/* The route is provisioned to the honest vehicle before access starts. */
rule Provision_Route:
  [ !VLong(V,sV), !PublicRSU(R), Fr(~nextR) ]
  --[ RouteProvisioned(V,R,~nextR) ]->
  [ !Route(V,R,~nextR)
  , Out(~nextR)
  ]


/* ------------------------------------------------------------------------- */
/* M4: Vehicle -> RSU.                                                       */
/* ------------------------------------------------------------------------- */

rule V_Send_M4:
  let A1     = 'g'^~a
      A2     = pkT^~a
      E2     = mask(<V,R,nextR>,h1(<A2,~t4>))
      sigma1 = h2(<A2,E2,sV,~t4>)
      sigma2 = cheb_eval(A2,sigma1)
      M4     = <'M4',A1,E2,sigma2,~t4>
      sid    = h1(<'ACCESS',A1,E2,~t4>)
  in
  [ !VLong(V,sV)
  , !TAPub(pkT)
  , !Route(V,R,nextR)
  , Fr(~a)
  , Fr(~t4)
  ]
  --[ VStart(V,R,sid,A1,E2,~t4) ]->
  [ VWaitM7(V,R,nextR,sV,~a,A1,A2,E2,~t4,sid)
  , Out(M4)
  ]


/* ------------------------------------------------------------------------- */
/* M5: RSU -> TA.  The RSU authenticates the forwarded request to the TA.   */
/* ------------------------------------------------------------------------- */

rule R_Forward_M5:
  let M4  = <'M4',A1,E2,sigma2,t4>
      sid = h1(<'ACCESS',A1,E2,t4>)
      RJ  = 'g'^~er
      mu  = h1(<skTJ,sid,tidR,RJ,M4,~t5>)
      M5  = <'M5',sid,tidR,RJ,mu,M4,~t5>
  in
  [ !RChannel(R,tidR,skTJ)
  , In(M4)
  , Fr(~er)
  , Fr(~t5)
  ]
  --[ RForward(R,tidR,sid,RJ,M4,~t5) ]->
  [ RWaitM6(R,tidR,skTJ,~er,RJ,A1,E2,sigma2,t4,sid,M4,~t5)
  , Out(M5)
  ]


/* ------------------------------------------------------------------------- */
/* M6: TA -> RSU.  Pattern matching performs all M4 and M5 checks.           */
/* ------------------------------------------------------------------------- */

rule TA_Send_M6:
  let A2       = A1^skT
      E2       = mask(<V,R,nextR>,h1(<A2,t4>))
      sigma1   = h2(<A2,E2,sV,t4>)
      sigma2   = cheb_eval(A2,sigma1)
      M4       = <'M4',A1,E2,sigma2,t4>
      sid      = h1(<'ACCESS',A1,E2,t4>)
      mu       = h1(<skTJ,sid,tidR,RJ,M4,t5>)
      sVn      = h1(<'NEXT-VEHICLE-SECRET',sid,A2,sV,~t6>)
      tidV     = h1(<'VEHICLE-PSEUDONYM',sid,V,R,sVn>)
      sigmaT3  = h2(<sid,sVn,tidV,RJ,~t6>)
      sigmaT4  = cheb_eval(RJ,sigmaT3)
      tidRn    = h1(<'NEXT-RSU-PSEUDONYM',sid,skTJ,tidR,~t6>)
      nonce1   = h2(<'M6-NONCE',sid,skTJ,mu,tidRn>)
      ad       = <'M6-AD',sid,tidR,RJ,~t6>
      ciph     = senc(<ad,nonce1,tidV,sigmaT4>,skTJ)
      M6       = <'M6',sid,ciph,~t6>
  in
  [ !TAKey(skT)
  , !TAVehicle(V,sV)
  , !TAChannel(R,tidR,skTJ)
  , In(<'M5',sid,tidR,RJ,mu,M4,t5>)
  , Fr(~t6)
  ]
  --[ ConsumeAccessSid(sid)
    , TAAcceptForward(R,tidR,sid,RJ,M4,t5)
    , TAAcceptVehicle(V,R,sid,A1,RJ,tidV,t4)
    , TASendM6(V,R,tidR,sid,tidV,RJ,sigmaT4,~t6)
    ]->
  [ TAPendingAck(V,R,tidR,skTJ,sid,tidV,sV,sVn,RJ)
  , Out(M6)
  ]

/* Implements the protocol's "reject a duplicate sid" requirement. */
restriction Consume_Access_Sid_Once:
  "All sid #i #j.
     ConsumeAccessSid(sid)@i & ConsumeAccessSid(sid)@j
     ==> #i = #j"


/* ------------------------------------------------------------------------- */
/* M7: RSU -> Vehicle.  AEAD verification binds M6 to M5 and this session.   */
/* ------------------------------------------------------------------------- */

rule R_Send_M7:
  let tidRn   = h1(<'NEXT-RSU-PSEUDONYM',sid,skTJ,tidR,t6>)
      mu      = h1(<skTJ,sid,tidR,RJ,M4,t5>)
      nonce1  = h2(<'M6-NONCE',sid,skTJ,mu,tidRn>)
      ad      = <'M6-AD',sid,tidR,RJ,t6>
      ciph    = senc(<ad,nonce1,tidV,sigmaT4>,skTJ)
      K       = A1^er
      tk      = h1(<'ACCESS-KEY',sid,K,R,tidV>)
      mac2    = h1(<'MAC2',tk,sid,sigmaT4,t6,~t7>)
      M7      = <'M7',sid,RJ,mac2,t6,~t7>
  in
  [ RWaitM6(R,tidR,skTJ,er,RJ,A1,E2,sigma2,t4,sid,M4,t5)
  , In(<'M6',sid,ciph,t6>)
  , Fr(~t7)
  ]
  --[ RRunningVehicle(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,~t7)
    , RSendM7(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,~t7)
    ]->
  [ RWaitM8(R,tidR,skTJ,tidV,sid,tk,A1,RJ,sigmaT4,t6,~t7)
  , Out(M7)
  ]


/* ------------------------------------------------------------------------- */
/* M8: Vehicle -> RSU.                                                       */
/* ------------------------------------------------------------------------- */

rule V_Send_M8:
  let sVn      = h1(<'NEXT-VEHICLE-SECRET',sid,A2,sV,t6>)
      tidV     = h1(<'VEHICLE-PSEUDONYM',sid,V,R,sVn>)
      sigmaT3  = h2(<sid,sVn,tidV,RJ,t6>)
      sigmaT4  = cheb_eval(RJ,sigmaT3)
      K        = RJ^a
      tk       = h1(<'ACCESS-KEY',sid,K,R,tidV>)
      mac2     = h1(<'MAC2',tk,sid,sigmaT4,t6,t7>)
      mac3     = h1(<'MAC3',tk,sid,tidV,~t8>)
      M7       = <'M7',sid,RJ,mac2,t6,t7>
      M8       = <'M8',sid,mac3,~t8>
  in
  [ VWaitM7(V,R,nextR,sV,a,A1,A2,E2,t4,sid)
  , In(M7)
  , Fr(~t8)
  ]
  --[ VAcceptRSUAndTA(V,R,tidV,sid,tk,A1,RJ)
    , VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,~t8)
    ]->
  [ VAccessAccepted(V,R,tidV,sid,tk,sV,sVn)
  , Out(M8)
  ]


/* ------------------------------------------------------------------------- */
/* ACK: RSU confirms M8 to the TA.                                           */
/* ------------------------------------------------------------------------- */

rule R_Send_ACK:
  let mac3 = h1(<'MAC3',tk,sid,tidV,t8>)
      ack  = h1(<'ACCESS-ACK',skTJ,sid,tidV,t8,~t9>)
      M8   = <'M8',sid,mac3,t8>
      ACK  = <'ACK',sid,ack,t8,~t9>
  in
  [ RWaitM8(R,tidR,skTJ,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7)
  , In(M8)
  , Fr(~t9)
  ]
  --[ RAcceptVehicle(R,tidV,sid,tk,A1,RJ,t8)
    , RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)
    , AccessKeyEstablished(R,tidV,sid,tk)
    ]->
  [ !EstablishedAccessKey(R,tidV,sid,tk)
  , Out(ACK)
  ]

rule TA_Receive_ACK:
  let ack = h1(<'ACCESS-ACK',skTJ,sid,tidV,t8,t9>)
  in
  [ TAPendingAck(V,R,tidR,skTJ,sid,tidV,sV,sVn,RJ)
  , In(<'ACK',sid,ack,t8,t9>)
  ]
  --[ TAFinishAccess(V,R,tidV,sid,RJ,t8,t9) ]->
  [ ]


/* ------------------------------------------------------------------------- */
/* Explicit compromise capabilities.                                        */
/* ------------------------------------------------------------------------- */

rule Reveal_Vehicle_Long_Term:
  [ !VLong(V,sV) ]
  --[ RevealVehicle(V,sV) ]->
  [ Out(<V,sV>) ]

/* Models compromise of the TA's per-vehicle database record. */
rule Reveal_TA_Vehicle_Record:
  [ !TAVehicle(V,sV) ]
  --[ RevealTARecord(V,sV) ]->
  [ Out(<V,sV>) ]

rule Reveal_RSU_TA_Channel:
  [ !RChannel(R,tidR,skTJ) ]
  --[ RevealChannel(R,tidR,skTJ) ]->
  [ Out(<R,tidR,skTJ>) ]

rule Reveal_TA_Master_Key:
  [ !TAKey(skT) ]
  --[ RevealTAKey(skT) ]->
  [ Out(skT) ]

rule Reveal_Access_Session_Key:
  [ !EstablishedAccessKey(R,tidV,sid,tk) ]
  --[ RevealAccessKey(R,tidV,sid,tk) ]->
  [ Out(tk) ]


/* ------------------------------------------------------------------------- */
/* Executability.                                                            */
/* ------------------------------------------------------------------------- */

lemma executable_access:
  exists-trace
  "Ex R tidV sid tk A1 RJ sigmaT4 t6 t7 t8 #i.
     RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i"

lemma executable_access_with_ta_ack:
  exists-trace
  "Ex V R tidV sid RJ t8 t9 #i.
     TAFinishAccess(V,R,tidV,sid,RJ,t8,t9)@i"


/* ------------------------------------------------------------------------- */
/* Authentication and agreement.                                            */
/* ------------------------------------------------------------------------- */

lemma ta_authenticates_rsu_forward:
  "All R tidR sid RJ M4 t5 #i.
     TAAcceptForward(R,tidR,sid,RJ,M4,t5)@i
   ==> (Ex #j. RForward(R,tidR,sid,RJ,M4,t5)@j & #j < #i)
     | (Ex sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)"

lemma ta_authenticates_vehicle:
  "All V R sid A1 RJ tidV t4 #i.
     TAAcceptVehicle(V,R,sid,A1,RJ,tidV,t4)@i
   ==> (Ex E2 #j. VStart(V,R,sid,A1,E2,t4)@j & #j < #i)
     | (Ex sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex sV #r. RevealTARecord(V,sV)@r & #r < #i)"

lemma vehicle_authenticates_rsu_and_ta:
  "All V R tidV sid tk A1 RJ #i.
     VAcceptRSUAndTA(V,R,tidV,sid,tk,A1,RJ)@i
   ==> ((Ex tidR sigmaT4 t6 #j.
           TASendM6(V,R,tidR,sid,tidV,RJ,sigmaT4,t6)@j & #j < #i)
        & (Ex sigmaT4 t6 t7 #k.
           RSendM7(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7)@k & #k < #i))
     | (Ex sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)
     | (Ex sV skT #r1 #r2.
          RevealTARecord(V,sV)@r1 & RevealTAKey(skT)@r2
          & #r1 < #i & #r2 < #i)"

lemma rsu_authenticates_vehicle:
  "All R tidV sid tk A1 RJ t8 #i.
     RAcceptVehicle(R,tidV,sid,tk,A1,RJ,t8)@i
   ==> (Ex V sigmaT4 t6 t7 #j.
          VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@j
          & #j < #i)
     | (Ex V sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex V sV #r. RevealTARecord(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)
     | (Ex #r. RevealAccessKey(R,tidV,sid,tk)@r & #r < #i)"

lemma vehicle_rsu_injective_agreement:
  "All V R tidV sid tk A1 RJ sigmaT4 t6 t7 t8 #i.
     VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i
   ==> ((Ex #j.
           RRunningVehicle(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7)@j
           & #j < #i)
        & (All V2 t82 #i2.
             VCommitAccess(V2,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t82)@i2
             ==> #i2 = #i))
     | (Ex sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)
     | (Ex sV skT #r1 #r2.
          RevealTARecord(V,sV)@r1 & RevealTAKey(skT)@r2
          & #r1 < #i & #r2 < #i)"

lemma rsu_vehicle_injective_agreement:
  "All R tidV sid tk A1 RJ sigmaT4 t6 t7 t8 #i.
     RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i
   ==> ((Ex V #j.
           VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@j
           & #j < #i)
        & (All #i2.
             RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i2
             ==> #i2 = #i))
     | (Ex V sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex V sV #r. RevealTARecord(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)
     | (Ex #r. RevealAccessKey(R,tidV,sid,tk)@r & #r < #i)"

lemma ta_ack_authenticates_rsu_completion:
  "All V R tidV sid RJ t8 t9 #i.
     TAFinishAccess(V,R,tidV,sid,RJ,t8,t9)@i
   ==> (Ex tk A1 sigmaT4 t6 t7 #j.
          RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@j
          & #j < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)"


/* ------------------------------------------------------------------------- */
/* Key confirmation and secrecy.                                            */
/* ------------------------------------------------------------------------- */

lemma vehicle_key_confirmation:
  "All V R tidV sid tk A1 RJ sigmaT4 t6 t7 t8 #i.
     VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i
   ==> (Ex #j.
          RRunningVehicle(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7)@j
          & #j < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)
     | (Ex sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex sV skT #r1 #r2.
          RevealTARecord(V,sV)@r1 & RevealTAKey(skT)@r2
          & #r1 < #i & #r2 < #i)"

lemma rsu_key_confirmation:
  "All R tidV sid tk A1 RJ sigmaT4 t6 t7 t8 #i.
     RCommitAccess(R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@i
   ==> (Ex V #j.
          VCommitAccess(V,R,tidV,sid,tk,A1,RJ,sigmaT4,t6,t7,t8)@j
          & #j < #i)
     | (Ex #r. RevealAccessKey(R,tidV,sid,tk)@r & #r < #i)
     | (Ex V sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex V sV #r. RevealTARecord(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)"

/*
 * If an established access key becomes known, an explicit compromise must
 * explain the disclosure.  Long-term compromises are only accepted as an
 * explanation when they happened before the completed access session; thus a
 * later long-term compromise alone must not reveal an old access key (PFS).
 */
lemma access_session_key_secrecy_and_pfs:
  "All R tidV sid tk #i #j.
     AccessKeyEstablished(R,tidV,sid,tk)@i & K(tk)@j
   ==> (Ex #r. RevealAccessKey(R,tidV,sid,tk)@r)
     | (Ex V sV #r. RevealVehicle(V,sV)@r & #r < #i)
     | (Ex V sV #r. RevealTARecord(V,sV)@r & #r < #i)
     | (Ex tidR sk #r. RevealChannel(R,tidR,sk)@r & #r < #i)"

end
